# Copy to .env for local development. In CI/production these come from
# environment variables / secrets instead -- never commit real values here.

# Pinata JWT (Pinata dashboard -> API Keys -> create a key with pinning
# permissions -> copy the JWT, not the API key/secret pair).
PINATA_JWT=

# Origin allowed to call this service cross-origin (browser CORS). Defaults
# to http://localhost:5173 (the frontend's Vite dev server) if unset. Set
# this to the deployed Netlify URL once the frontend is deployed there.
CORS_ALLOWED_ORIGIN=

# Max POST requests per minute, per client, to /upload and /listing-metadata
# combined. Defaults to 10 if unset. Set to 0 (or a negative number) to
# disable rate limiting entirely -- not recommended outside local dev.
RATE_LIMIT_REQUESTS_PER_MINUTE=

# Sepolia RPC endpoint (same value as the root lost-and-found-back/.env's
# SEPOLIA_RPC_URL -- these are separate .env files for separate processes,
# so it must be set here too). Required for the owner<->finder messaging
# endpoints (POST/GET /listings/:id/messages), which read the contract to
# verify a message's sender is the listing's owner or finder. Read-only,
# no private key needed.
SEPOLIA_RPC_URL=

# Deployed LostAndFound contract address. Defaults to the address in
# ../deployments/sepolia.json if unset -- update this (and that file) if
# the contract is ever redeployed to a new address.
CONTRACT_ADDRESS=

# Path to the SQLite database file used for owner<->finder chat messages.
# Defaults to messages.db (relative to the working directory) if unset.
# Note: on Render's ephemeral filesystem this does NOT persist across a
# redeploy/restart -- this is documented, deliberate "temporary" storage,
# not a bug. Tests use ":memory:" for an isolated, non-persistent database.
MESSAGES_DB_PATH=
