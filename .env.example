# Copy to .env for local Sepolia deploys (npx hardhat run scripts/deploy.js --network sepolia).
# In CI, these come from GitHub Actions secrets instead -- never commit real values here.

# Sepolia RPC endpoint, e.g. from Alchemy or Infura.
SEPOLIA_RPC_URL=

# Private key of a Sepolia-funded deployer wallet (no 0x prefix needed either way,
# ethers accepts both). Never use a wallet holding real funds.
SEPOLIA_PRIVATE_KEY=
